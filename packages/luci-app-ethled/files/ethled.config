# S20P 网口指示灯控制
#
# global.enabled      1 = 开机和链路恢复后按本文件下发；0 = 完全不碰寄存器
# global.apply_on_link 1 = netifd 每次 ifup 后重新下发（防止驱动或 PHY 复位覆盖）
# global.switch_lan  0 = 不动 LAN1-5（MT7531 内部 PHY）。置 1 会按下面 lan* 段里的
#                       寄存器值写入；本板的 MT7531 灯寄存器出厂靠硬件默认值工作，
#                       开启前请先用 LuCI 的「读取寄存器」或 `ethled dump` 对照。
#
# RTL8221B（lan6 / wan）：每个 LED 一个 link-select 寄存器 0xd032/0xd034/0xd036，
#   speeds 里写哪些速率点亮：10 100 1000 2500（位定义来自内核 realtek 驱动）。
#   blink 只决定该 LED 是否参与流量闪烁；invert 是极性位。
#   enable=0 等价内核的 LED_OFF：link-select 写 0、activity 与 polarity 清位。
#   默认值（三个 LED 全速率、只有 led0 闪烁、极性 0）与固件 DTS 现有配置一致，
#   所以打开本功能不会改变现在的灯光表现，只是让你能随时关掉。
#
# MT7531（lan1-lan5）：led0_on_ctrl/led0_blink_ctrl 写 0x24/0x25，
#   led1_on_ctrl/led1_blink_ctrl 写 0x26/0x27；enable=0 时写 0x8000/0x0000
#   （树内 acer/ruijie DTS 对「此灯不点亮」用的就是这个值）。

config global 'global'
	option enabled '1'
	option apply_on_link '1'
	option switch_lan '0'

config port 'lan6'
	option label 'LAN6 · 2.5G'
	option type 'rtl8221b'
	option bus 'mdio-bus'
	option phy '5'
	option enabled '1'
	option led0_enable '1'
	option led0_speeds '10 100 1000 2500'
	option led0_blink '1'
	option led0_invert '0'
	option led1_enable '1'
	option led1_speeds '10 100 1000 2500'
	option led1_blink '0'
	option led1_invert '0'
	option led2_enable '1'
	option led2_speeds '10 100 1000 2500'
	option led2_blink '0'
	option led2_invert '0'

config port 'wan'
	option label 'WAN (eth1) · 2.5G'
	option type 'rtl8221b'
	option bus 'mdio-bus'
	option phy '7'
	option enabled '1'
	option led0_enable '1'
	option led0_speeds '10 100 1000 2500'
	option led0_blink '1'
	option led0_invert '0'
	option led1_enable '1'
	option led1_speeds '10 100 1000 2500'
	option led1_blink '0'
	option led1_invert '0'
	option led2_enable '1'
	option led2_speeds '10 100 1000 2500'
	option led2_blink '0'
	option led2_invert '0'

config port 'lan1'
	option label 'LAN1'
	option type 'mt7531'
	option bus 'mt7530_dsa-0'
	option phy '4'
	option enabled '1'
	option led0 '1'
	option led0_on_ctrl '0xc001'
	option led0_blink_ctrl '0x0003'
	option led1 '1'
	option led1_on_ctrl '0xc006'
	option led1_blink_ctrl '0x003c'

config port 'lan2'
	option label 'LAN2'
	option type 'mt7531'
	option bus 'mt7530_dsa-0'
	option phy '3'
	option enabled '1'
	option led0 '1'
	option led0_on_ctrl '0xc001'
	option led0_blink_ctrl '0x0003'
	option led1 '1'
	option led1_on_ctrl '0xc006'
	option led1_blink_ctrl '0x003c'

config port 'lan3'
	option label 'LAN3'
	option type 'mt7531'
	option bus 'mt7530_dsa-0'
	option phy '2'
	option enabled '1'
	option led0 '1'
	option led0_on_ctrl '0xc001'
	option led0_blink_ctrl '0x0003'
	option led1 '1'
	option led1_on_ctrl '0xc006'
	option led1_blink_ctrl '0x003c'

config port 'lan4'
	option label 'LAN4'
	option type 'mt7531'
	option bus 'mt7530_dsa-0'
	option phy '1'
	option enabled '1'
	option led0 '1'
	option led0_on_ctrl '0xc001'
	option led0_blink_ctrl '0x0003'
	option led1 '1'
	option led1_on_ctrl '0xc006'
	option led1_blink_ctrl '0x003c'

config port 'lan5'
	option label 'LAN5'
	option type 'mt7531'
	option bus 'mt7530_dsa-0'
	option phy '0'
	option enabled '1'
	option led0 '1'
	option led0_on_ctrl '0xc001'
	option led0_blink_ctrl '0x0003'
	option led1 '1'
	option led1_on_ctrl '0xc006'
	option led1_blink_ctrl '0x003c'
